{
  "name": "brand-schema-tag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Brand Schema Tag plan selection and EmailJS applications.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@emailjs/browser": "5.0.3",
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
